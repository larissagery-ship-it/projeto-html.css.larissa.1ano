document.addEventListener("DOMContentLoaded", function () {
    console.log("JavaScript carregado com sucesso!");

    // Seleciona todos os botões da página
    const botoes = document.querySelectorAll("button");
    console.log("Quantidade de botões encontrados:", botoes.length);

    botoes.forEach(function (botao) {
        let curtiu = false; // Controle de estado do botão

        botao.addEventListener("click", function () {
            console.log("Botão clicado!");

            // Seleciona o elemento <span> dentro do botão clicado
            let spanTexto = botao.querySelector("span");

            // Verifica se o span existe dentro do botão para evitar erros
            if (spanTexto) {
                // Converte o valor atual do texto para número
                let contador = parseInt(spanTexto.textContent, 10) || 0;

                if (!curtiu) {
                    contador++;       // Incrementa o contador
                    curtiu = true;    // Marca como curtido
                    botao.classList.add("curtido"); // Opcional: adiciona classe CSS
                } else {
                    contador--;       // Decrementa o contador
                    curtiu = false;   // Marca como não curtido
                    botao.classList.remove("curtido"); // Opcional: remove classe CSS
                }

                // Atualiza o texto do span com o novo valor
                spanTexto.textContent = contador;
            }
        });
    });
});