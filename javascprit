document.addEventListener("DOMContentLoaded", function () {
    console.log("JavaScript carregado com sucesso!");

    // Seleciona todos os botões de reação (coração e joinha)
    const botoes = document.querySelectorAll("button"); // Alterado para selecionar todos os botões, como no exemplo da aula
    console.log("Quantidade de botões encontrados:", botoes.length);

    botoes.forEach(function (botao) {
        let curtiu = false; // Variável para controlar se o botão já foi clicado

        // Adiciona um ouvinte de evento de clique a cada botão
        botao.addEventListener("click", function () { // Usamos uma função anônima aqui, mas a função nomeada 'botaoClicado' também funciona
            console.log("Botão clicado!");

            // Seleciona o span dentro do botão para atualizar o contador
            let texto = botao.querySelector("span");

            // Verifica se o botão já foi curtido
            if (curtiu === false) { // Se ainda não curtiu
                texto.textContent++; // Incrementa o contador
                curtiu = true;       // Marca como curtido
            } else {                 // Se já curtiu (e clicou novamente para descurtir)
                texto.textContent--; // Decrementa o contador
                curtiu = false;      // Marca como não curtido
            }
        });
    });
});
const botoes = document.querySelectorAll("button");

botoes.forEach(function (botao) {
    let curtiu = false;
    botao.addEventListener("click", botaoClicado);
    function botaoClicado() {
        console.log("fui clicado");
        let texto = botao.querySelector("span");
        if (curtiu === false) {
            texto.textContent++;
            curtiu = true;
        } else {
            texto.textContent--;
            curtiu = false;
        }
    }
});