// Aguarda o HTML carregar completamente antes de rodar o script
document.addEventListener("DOMContentLoaded", function () {

    // --- Lógica das Reações (Curtir / Descurtir) ---
    const botoesReacao = document.querySelectorAll(".btn-reacao");

    botoesReacao.forEach(function (botao) {
        let curtiu = false;

        botao.addEventListener("click", function () {
            const span = botao.querySelector("span");
            let contador = Number(span.textContent);

            if (!curtiu) {
                span.textContent = contador + 1;
                curtiu = true;
            } else {
                span.textContent = contador - 1;
                curtiu = false;
            }
        });
    });

    // --- Lógica dos Botões de Interatividade (Mágica) ---
    const botoesFun = document.querySelectorAll(".btn-fun");

    botoesFun.forEach(function (botao) {
        botao.addEventListener("click", function () {
            // Pega o elemento com a mensagem que está no mesmo bloco do botão
            const secao = botao.parentElement;
            const mensagem = secao.querySelector(".mensagem-magica");

            if (mensagem) {
                mensagem.classList.toggle("hidden");
            }
        });
    });

});