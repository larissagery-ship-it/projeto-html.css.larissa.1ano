document.addEventListener("DOMContentLoaded", function () {
    console.log("JavaScript carregado com sucesso!");

    const botoes = document.querySelectorAll(".btn-reacao");
    console.log("Quantidade de botões encontrados:", botoes.length);

    botoes.forEach(function (botao) {
        let curtiu = false;

        botao.addEventListener("click", function () {
            const span = botao.querySelector("span");
            
            if (!span) {
                console.error("Não foi encontrada a tag <span> dentro do botão!");
                return;
            }

            let valor = parseInt(span.innerText) || 0;

            if (!curtiu) {
                span.innerText = valor + 1;
                curtiu = true;
            } else {
                span.innerText = valor - 1;
                curtiu = false;
            }
        });
    });
});