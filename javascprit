// --- Lógica das Reações (Curtir / Descurtir) ---
const botoesReacao = document.querySelectorAll(".btn-reacao");

botoesReacao.forEach(function (botao) {
    let curtiu = false; // Cada botão tem seu próprio controle do estado

    botao.addEventListener("click", function () {
        let span = botao.querySelector("span");
        let valorAtual = parseInt(span.textContent);

        if (!curtiu) {
            span.textContent = valorAtual + 1;
            curtiu = true;
            botao.classList.add("ativo"); // Opcional: para estilizar quando curtido
        } else {
            span.textContent = valorAtual - 1;
            curtiu = false;
            botao.classList.remove("ativo");
        }
    });
});

// --- Lógica dos Botões de Mágica (Interatividade) ---
const botoesFun = document.querySelectorAll(".btn-fun");

botoesFun.forEach(function (botao) {
    botao.addEventListener("click", function () {
        // Encontra o card pai e depois a mensagem mágica dentro dele
        const card = botao.closest(".interact-section");
        const mensagem = card.querySelector(".mensagem-magica");
        
        mensagem.classList.toggle("hidden");
    });
});