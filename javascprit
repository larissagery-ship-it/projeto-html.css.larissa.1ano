// 1. Lógica para os Botões de Reação (Curtidas)
const botoesReacao = document.querySelectorAll(".btn-reacao");

botoesReacao.forEach(function(botao) {
    botao.addEventListener("click", function() {
        let texto = botao.querySelector("span");
        texto.textContent = Number(texto.textContent) + 1;
    });
});

// 2. Lógica para o Botão Mágico (#btn-fun)
const btnFun = document.querySelector("#btn-fun");
const mensagem = document.querySelector("#mensagem");

btnFun.addEventListener("click", function() {
    mensagem.classList.toggle("hidden");
});